{
  "expo": {
    "name": "Driver Waruung",
    "slug": "waruung-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/waruung-driver-app-icon.png",
    "scheme": "waruungdriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/waruung-driver-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waruung.driver",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCQOfitYRU7iAHMRaj0dwcrI8-UQIiFPWI"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.waruung.driver",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/waruung-driver-app-icon.png",
        "backgroundColor": "#40a3ea"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCQOfitYRU7iAHMRaj0dwcrI8-UQIiFPWI"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Waruung Driver memerlukan akses lokasi untuk melacak posisimu dan mengarahkan ke titik jemput/tujuan.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Waruung Driver memerlukan akses galeri untuk mengganti foto profil.",
          "cameraPermission": "Waruung Driver memerlukan akses kamera untuk mengambil foto profil."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan aplikasi mengakses galeri untuk menyimpan QRIS.",
          "savePhotosPermission": "Izinkan aplikasi menyimpan QRIS ke galeri."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/waruung-driver-app-icon.png",
          "color": "#40a3ea",
          "defaultChannel": "driver-orders-v4",
          "sounds": [
            "./assets/sounds/driver_order.mp3"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "Driver Waruung"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyCQOfitYRU7iAHMRaj0dwcrI8-UQIiFPWI",
      "router": {},
      "eas": {
        "projectId": "8620324e-354e-47b8-b0f6-1d5ff9b631fe"
      }
    },
    "owner": "amirku"
  }
}